# ─────────────────────────────────────────────────────────────
# AmarDoctor Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────

# Backend API URL (Points to local server in dev, or Render URL in production)
VITE_API_BASE_URL=http://localhost:8000/api

# Toggle Demo Accounts UI (Set to "true" for testing, "false" for real production)
VITE_SHOW_DEMO=true
